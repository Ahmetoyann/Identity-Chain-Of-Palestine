APP_NAME=Identity Chain API
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://identity_chain:change-me@localhost:5432/identity_chain
POSTGRES_USER=identity_chain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=identity_chain
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
